#!/bin/sh
set -e

# shellcheck source=/dev/null
. /usr/share/debconf/confmodule

# On upgrades, or when already configured, do not ask again.
if [ -s /etc/cloudflare-ddns/config.toml ] && [ -s /etc/cloudflare-ddns/cloudflare.env ]; then
    exit 0
fi

db_input high cloudflare-ddns/api_token || true
db_input high cloudflare-ddns/zone_id || true
db_input high cloudflare-ddns/record_id || true
db_input high cloudflare-ddns/record_name || true
db_input medium cloudflare-ddns/interval_seconds || true
db_go || true

exit 0
